# RENDERED BY `qops install` from qops/templates/automerge.yml.tmpl + .qops/config.yml
# Do not hand-edit: `qops doctor` fails on drift.
#
# ADR-0020. A green `gate:machine` PR merges itself: the gate has already
# judged it, so the click was a mindless approval button, and a mindless
# approval button is not a control.
#
# This workflow does NOT merge. It turns on GitHub's native auto-merge, which
# waits for branch protection's required checks (test, gate, tripwires,
# doc-links). The workflow is the control — it fires without anyone
# remembering — and the gate stays the thing that decides.
name: automerge

on:
  pull_request:
    types: [opened, reopened, synchronize, labeled, unlabeled, ready_for_review]

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  enable:
    # Every condition here is a reason it is safe for no human to read the
    # diff. Loosening one fails a test in tests/test_qops.py.
    #   gate:machine  — the label that authorises it; gate:taste never merges
    #   no-auto       — the standing per-issue veto, already in the taxonomy
    #   draft         — a draft is not a claim that the work is done
    #   fork          — an outside contributor's PR is a taste decision, and a
    #                   fork token cannot be trusted with this repo's merges
    if: >-
      github.event.pull_request.draft == false
      && github.event.pull_request.head.repo.full_name == github.repository
      && contains(github.event.pull_request.labels.*.name, 'gate:machine')
      && !contains(github.event.pull_request.labels.*.name, 'no-auto')
    runs-on: {{runs_on}}
    permissions:
      contents: write
      pull-requests: write
    steps:
      - name: the branch carries an issue number (ADR-0019)
        id: branch
        # REF is an environment variable, never interpolated into the script:
        # a branch name is attacker-controlled on a public repo.
        env:
          REF: ${{ github.event.pull_request.head.ref }}
        run: |
          if printf '%s' "$REF" | grep -Eq '^[a-z]+/[0-9]+-|^no-issue/'; then
            echo "ok=true" >> "$GITHUB_OUTPUT"
          else
            echo "::notice::branch does not carry an issue number - not auto-merging"
            echo "ok=false" >> "$GITHUB_OUTPUT"
          fi

      - name: hand the merge to the required checks
        if: steps.branch.outputs.ok == 'true'
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          PR: ${{ github.event.pull_request.number }}
        run: gh pr merge --auto --squash --delete-branch --repo {{repo}} "$PR"
