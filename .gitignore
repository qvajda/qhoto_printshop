*.log
npm-debug.log*

# Local runtime data
db/*.sqlite3
db/*.bak-*
db/*.lock
db/base_artwork/
db/group_preview_images/

# Agent / tooling scratch dirs (local, not project source)
.agents/
# .claude/ is NARROWED, not ignored wholesale (PRD v3 finding A4, ADR-0001).
# Hook configuration is project source: without it committed, the brief, the
# resume writer, the ledger and the guard exist on one laptop only, which is the
# failure mode where a system appears to work and is actually one machine.
# `.claude/*` rather than `.claude/` is REQUIRED - git cannot re-include a file
# whose parent is excluded by a directory-style pattern.
.claude/*
!.claude/settings.json
!.claude/agents/
# The three qops-native skill bodies are OURS to maintain (ADR-0018), so they are
# source and they are tracked. The surviving external copies are not: they are
# reinstallable from skills-lock.json, which carries the ref they came from.
!.claude/skills/
.claude/skills/*
!.claude/skills/interview/
!.claude/skills/spec-to-issue/
!.claude/skills/triage/

# qops — the split is decided, not inherited (PRD v3 decision 21 / finding E1).
# TRACKED, deliberately: .qops/config.yml and .qops/issues.md.
# IGNORED, deliberately: machine state, rewritten every session.
.qops/state.json
.qops/resume.md
.qops/ledger.jsonl
.qops/outbox.jsonl
.qops/wt/

# Git worktrees
.worktrees/

# Session handoff notes (local scratch, not project docs)
.remember/

# OAuth PKCE state (short-lived, holds code_verifier)
.etsy_oauth_state.json

# Raw scene generations awaiting a screen. The tracked inflow files are the
# SCREENED, renamed ones (lifestyle_*.png + .json); `replicate-prediction-*` is
# the generator's own output, ~5 MB each, superseded the moment it is named or
# rejected. Zero were ever tracked; this makes that a rule instead of a habit.
assets/mockups/inflow/**/replicate-prediction-*

# Windows Explorer droppings
desktop.ini

# qops hook spike — throwaway diagnostic, left ARMED so Cowork and PreCompact
# answer themselves (ADR-0001). Never project source.
.qops/hook-spike/

